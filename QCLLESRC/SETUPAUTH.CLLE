      /*==============================================================*/
      /* CLプログラム: SETUPAUTH                                      */
      /* ライブラリ: HANBAI                                          */
      /* 説明: 権限設定（ロールベースアクセス制御）                   */
      /*==============================================================*/
             PGM

             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10) VALUE('HANBAI')
             DCL        VAR(&MSGID) TYPE(*CHAR) LEN(7)
             DCL        VAR(&MSGDTA) TYPE(*CHAR) LEN(512)

             MONMSG     MSGID(CPF0000) EXEC(GOTO CMDLBL(ERROR))

      /*--------------------------------------------------------------*/
      /* グループプロファイルの作成                                   */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('グループプロファイルを作成中...') TOPGMQ(*EXT)

      /* 営業グループ */
             CRTUSRPRF  USRPRF(O2CSALES) PASSWORD(*NONE) USRCLS(*USER) TEXT('O2C Sales Role') +
                          GRPPRF(*NONE)
             MONMSG     MSGID(CPF2204) /* 既に存在 */

      /* 倉庫グループ */
             CRTUSRPRF  USRPRF(O2CWHSE) PASSWORD(*NONE) USRCLS(*USER) TEXT('O2C Warehouse +
                          Role') GRPPRF(*NONE)
             MONMSG     MSGID(CPF2204)

      /* 経理グループ */
             CRTUSRPRF  USRPRF(O2CACCT) PASSWORD(*NONE) USRCLS(*USER) TEXT('O2C Accounting +
                          Role') GRPPRF(*NONE)
             MONMSG     MSGID(CPF2204)

      /* 管理者グループ */
             CRTUSRPRF  USRPRF(O2CADMIN) PASSWORD(*NONE) USRCLS(*USER) TEXT('O2C Administrator +
                          Role') GRPPRF(*NONE)
             MONMSG     MSGID(CPF2204)

      /*--------------------------------------------------------------*/
      /* 営業グループの権限設定                                       */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('営業グループの権限を設定中...') TOPGMQ(*EXT)

      /* 顧客マスタ: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/CUSTOMERP) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/CUSTOMERL1) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)

      /* 商品マスタ: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/ITEMP) OBJTYPE(*FILE) USER(O2CSALES) AUT(*USE)
             GRTOBJAUT  OBJ(&LIB/ITEML1) OBJTYPE(*FILE) USER(O2CSALES) AUT(*USE)

      /* 受注: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/SORDERHP) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/SORDERLP) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/SORDERHL1) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/SORDERHL2) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/SORDERLL1) OBJTYPE(*FILE) USER(O2CSALES) AUT(*CHANGE)

      /* 在庫: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/INVENTORYP) OBJTYPE(*FILE) USER(O2CSALES) AUT(*USE)
             GRTOBJAUT  OBJ(&LIB/INVENTORL1) OBJTYPE(*FILE) USER(O2CSALES) AUT(*USE)

      /*--------------------------------------------------------------*/
      /* 倉庫グループの権限設定                                       */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('倉庫グループの権限を設定中...') TOPGMQ(*EXT)

      /* 在庫: 読取・更新 */
             GRTOBJAUT  OBJ(&LIB/INVENTORYP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/INVENTORL1) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*CHANGE)

      /* 受注: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/SORDERHP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*USE)
             GRTOBJAUT  OBJ(&LIB/SORDERLP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*USE)

      /* 出荷: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/SHIPMENTHP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/SHIPMENTLP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*CHANGE)

      /* 商品マスタ: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/ITEMP) OBJTYPE(*FILE) USER(O2CWHSE) AUT(*USE)

      /*--------------------------------------------------------------*/
      /* 経理グループの権限設定                                       */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('経理グループの権限を設定中...') TOPGMQ(*EXT)

      /* 請求: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/INVOICEHP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*CHANGE)
             GRTOBJAUT  OBJ(&LIB/INVOICELP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*CHANGE)

      /* 入金: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/PAYMENTP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*CHANGE)

      /* 顧客マスタ: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/CUSTOMERP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*USE)

      /* 受注・出荷: 読取のみ */
             GRTOBJAUT  OBJ(&LIB/SORDERHP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*USE)
             GRTOBJAUT  OBJ(&LIB/SORDERLP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*USE)
             GRTOBJAUT  OBJ(&LIB/SHIPMENTHP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*USE)

      /* 為替レート: 読取・追加・更新 */
             GRTOBJAUT  OBJ(&LIB/FXRATEP) OBJTYPE(*FILE) USER(O2CACCT) AUT(*CHANGE)

      /*--------------------------------------------------------------*/
      /* 管理者グループの権限設定                                     */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('管理者グループの権限を設定中...') TOPGMQ(*EXT)

      /* 全ファイルに対する完全な権限 */
             GRTOBJAUT  OBJ(&LIB/*ALL) OBJTYPE(*FILE) USER(O2CADMIN) AUT(*ALL)

      /* ライブラリに対する権限 */
             GRTOBJAUT  OBJ(&LIB) OBJTYPE(*LIB) USER(O2CADMIN) AUT(*ALL)

      /*--------------------------------------------------------------*/
      /* 共通マスタの権限設定（全グループ読取可能）                   */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('共通マスタの権限を設定中...') TOPGMQ(*EXT)

             GRTOBJAUT  OBJ(&LIB/CODEMSTRP) OBJTYPE(*FILE) USER(O2CSALES O2CWHSE O2CACCT) AUT(*USE)

             GRTOBJAUT  OBJ(&LIB/WAREHOUSEP) OBJTYPE(*FILE) USER(O2CSALES O2CWHSE O2CACCT) +
                          AUT(*USE)

      /*--------------------------------------------------------------*/
      /* 変更履歴の権限設定（管理者のみ）                             */
      /*--------------------------------------------------------------*/
             GRTOBJAUT  OBJ(&LIB/CHANGELOGP) OBJTYPE(*FILE) USER(O2CADMIN) AUT(*ALL)

      /*--------------------------------------------------------------*/
      /* 完了メッセージ                                               */
      /*--------------------------------------------------------------*/
             SNDPGMMSG  MSG('権限設定が完了しました') TOPGMQ(*EXT) MSGTYPE(*COMP)

             GOTO       CMDLBL(ENDPGM)

      /*--------------------------------------------------------------*/
      /* エラー処理                                                   */
      /*--------------------------------------------------------------*/
 ERROR:
             RCVMSG     MSGTYPE(*EXCP) MSGDTA(&MSGDTA) MSGID(&MSGID)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('エラー: ' *BCAT &MSGID *BCAT ' - ' +
                          *BCAT &MSGDTA) MSGTYPE(*ESCAPE)

 ENDPGM:
             ENDPGM
